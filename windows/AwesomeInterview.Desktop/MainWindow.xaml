<Window x:Class="AwesomeInterview.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Awesome Interview" Width="1280" Height="820" MinWidth="800" MinHeight="560"
        Background="#F3F6FC" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="13,11"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="214"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#16234A">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,24,18,14">
          <TextBlock Text="AI" FontSize="20" FontWeight="Bold" Foreground="White" Background="#4365FF" Padding="11,8" HorizontalAlignment="Left"/>
          <TextBlock Text="Awesome Interview" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4"/>
          <TextBlock Text="面试与日程工作台" Foreground="#BFC9E8" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,18">
          <TextBlock x:Name="SyncLabel" Text="尚未同步" Foreground="#BFC9E8" TextWrapping="Wrap" FontSize="11" Margin="4,4,4,8"/>
          <Button Content="立即同步" Click="Sync_Click" Style="{StaticResource NavButton}"/>
          <Button Content="退出登录" Click="Logout_Click" Style="{StaticResource NavButton}"/>
          <TextBlock Text="关闭窗口后在系统托盘保持提醒" Foreground="#96A5D3" TextWrapping="Wrap" FontSize="11" Margin="5,10,5,0"/>
        </StackPanel>
        <StackPanel Margin="14,0,14,0">
          <Button Content="面经广场" Tag="/my-schedule/experiences/plaza" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button Content="日程表" Tag="/my-schedule" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button Content="添加日程" Tag="/my-schedule/new" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button Content="我的面试" Tag="/my-schedule/interviews" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button Content="我的面经" Tag="/my-schedule/experiences" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button Content="个人设置" Tag="/my-schedule/profile" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Margin="16" Background="White" CornerRadius="12" BorderBrush="#DCE3F0" BorderThickness="1">
      <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Visible"/>
        <Grid x:Name="OfflinePanel" Background="White" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="30,26,30,18">
            <TextBlock Text="离线只读" FontSize="24" FontWeight="Bold" Foreground="#16234A"/>
            <TextBlock x:Name="OfflineSubtitle" Text="服务器暂不可用" Margin="0,8,0,0" Foreground="#687996"/>
            <Button Content="重试连接" Click="Reconnect_Click" HorizontalAlignment="Left" Padding="16,7" Margin="0,12,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="OfflineContent" TextWrapping="Wrap" Margin="30,0,30,30" FontSize="14" LineHeight="24" Foreground="#24334E"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
